# Core AI provider credentials
# Use OPENAI_API_KEY and/or GROQ_API_KEY depending on src/config/ai-providers.json.
OPENAI_API_KEY=sk-...
GROQ_API_KEY=gsk_...

# AWS Route 53 Domains availability checks
# IAM permission needed: route53domains:CheckDomainAvailability
# Route 53 Domains only works in us-east-1.
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# Google Identity Services (required for the Google sign-in button)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<google web client id>

# Stripe billing (required only if you enable subscriptions)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY_EUR_ID=price_...
STRIPE_PRICE_YEARLY_EUR_ID=price_...
STRIPE_PRICE_MONTHLY_USD_ID=price_...
STRIPE_PRICE_YEARLY_USD_ID=price_...

# Free usage limits
FREE_CREDIT_IDENTITY_SALT=<random-long-secret>
FREE_CREDITS_TOTAL=100
FREE_CREDITS_COST_SEARCH=10
FREE_CREDITS_COST_EXPLAIN=1

# Site/app configuration
# Use localhost values in development. Override these in production.
APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Domain Search Starter
NEXT_PUBLIC_SITE_TAGLINE=Find your perfect domain name with AI
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_COMPANY_LEGAL_NAME=Your Company
NEXT_PUBLIC_COMPANY_ADDRESS=Your business address
NEXT_PUBLIC_COMPANY_REGISTRATION_ID=Your company registration number

# Optional analytics / affiliate / verification
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_IMPACT_SITE_VERIFICATION=
NEXT_PUBLIC_NAMECHEAP_AFFILIATE_ID=

# Optional Namecheap bulk availability checks
# If these are unset, the app falls back to Route 53 only.
NAMECHEAP_API_USER=<namecheap-username>
NAMECHEAP_API_KEY=<api-key>
NAMECHEAP_CLIENT_IP=<client-ip>

# Optional integrations
SLACK_FEEDBACK_WEBHOOK_URL=

# GDPR region detection
GDPR_COUNTRY_HEADER_NAME=cf-ipcountry
GDPR_DEFAULT_REGION=eu

# Operational controls
# Set to true only when you explicitly need verbose server logs.
DEBUG_LOGGING=false
