# OpenAI API key (required)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Groq API key (required when generateDomains.provider or explain.provider is Groq)
# Get from: https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# AWS credentials for Route 53 Domains availability checks (required)
# IAM permission needed: route53domains:CheckDomainAvailability only
# Note: Route 53 Domains API is only available in us-east-1
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1

# Supabase (required for auth)
# Get from: https://supabase.com/dashboard/project/<your-project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# Google Identity Services (required for on-site Google sign-in)
# Get from: Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<google web client id>

# GitHub OAuth (optional — enables "Continue with GitHub" on login page)
# Configured in Supabase Dashboard > Authentication > Providers > GitHub
# Get Client ID and Secret from: https://github.com/settings/developers > OAuth Apps
GITHUB_CLIENT_ID=<github oauth app client id>
GITHUB_CLIENT_SECRET=<github oauth app client secret>

# Stripe billing (required for subscriptions)
# Use Stripe test keys locally and Stripe live keys in production
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY_EUR_ID=price_...
STRIPE_PRICE_YEARLY_EUR_ID=price_...
STRIPE_PRICE_MONTHLY_USD_ID=price_...
STRIPE_PRICE_YEARLY_USD_ID=price_...

# Free usage limits (required for billing)
# FREE_CREDITS_TOTAL is a one-time allowance and does not reset
FREE_CREDIT_IDENTITY_SALT=<random-long-secret>
FREE_CREDITS_TOTAL=100
FREE_CREDITS_COST_SEARCH=10
FREE_CREDITS_COST_EXPLAIN=1

# Canonical application URL (recommended for server-side redirects and Stripe return URLs)
# Set this to your local app origin in development if you test auth or billing locally.
APP_URL=https://domaingazer.com

# Public site URL (used for sitemap, canonical URLs, and OG metadata)
# Server-side redirects fall back to this when APP_URL is unset.
NEXT_PUBLIC_SITE_URL=https://domaingazer.com

# GDPR region detection (optional)
# On VPS/Nginx, request.geo is usually unavailable. If no country is detected, the app defaults to EU behavior.
# Set GDPR_COUNTRY_HEADER_NAME if your reverse proxy injects a country code header (e.g. X-Country-Code).
# Set GDPR_DEFAULT_REGION=non-eu only if you explicitly want unknown traffic treated as non-EU.
GDPR_COUNTRY_HEADER_NAME=cf-ipcountry
GDPR_DEFAULT_REGION=eu

# Slack incoming webhook for feedback notifications (optional)
# Get from: https://api.slack.com/apps → Your App → Incoming Webhooks
SLACK_FEEDBACK_WEBHOOK_URL=

# Microsoft Clarity (optional — session recording & heatmaps)
# Get from: https://clarity.microsoft.com → Settings → Overview → Project ID
NEXT_PUBLIC_CLARITY_PROJECT_ID=
